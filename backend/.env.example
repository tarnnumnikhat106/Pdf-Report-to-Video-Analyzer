# Environment variables for MedVision AI Backend
PORT=8000
HOST=0.0.0.0

# Optional: Google Gemini API key for advanced dynamic medical reasoning
# Get your free key at https://aistudio.google.com/
GEMINI_API_KEY=

# Optional: OpenAI API Key (if preferred)
OPENAI_API_KEY=

# Optional: Preferred Text-to-Speech Voice (Microsoft Neural via edge-tts)
# Options include: en-US-JennyNeural, en-US-GuyNeural, en-GB-SoniaNeural
TTS_VOICE=en-US-JennyNeural
