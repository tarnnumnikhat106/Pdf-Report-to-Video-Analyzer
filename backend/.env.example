# Environment variables for MedVision AI Backend
PORT=8000
HOST=0.0.0.0
# Reload is off by default so uploads/video files do not restart the backend
# and clear the in-memory API key. Set to 1 only while editing backend code.
BACKEND_RELOAD=0

# Optional external LLM. You can also paste a key in the hidden /ai-settings page.
# Groq (free): https://console.groq.com/keys
# Gemini (free tier): https://aistudio.google.com/apikey
# OpenRouter: https://openrouter.ai/keys
# OpenAI: https://platform.openai.com/api-keys
# LLM_PROVIDER=groq
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=

# Or use a provider-specific key with its default preset:
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# Optional: Preferred Text-to-Speech Voice (Microsoft Neural via edge-tts)
# Warm defaults: en-US-AvaMultilingualNeural, en-US-EmmaMultilingualNeural
# Other options: en-US-JennyNeural, en-US-GuyNeural, en-GB-SoniaNeural
TTS_VOICE=en-US-AvaMultilingualNeural
TTS_RATE=-4%
TTS_PITCH=+0Hz
TTS_VOLUME=+0%

# Hinglish narration uses a native Hindi neural voice from Edge TTS.
TTS_VOICE_HINDI=hi-IN-SwaraNeural
TTS_RATE_HINDI=-5%
TTS_PITCH_HINDI=+0Hz
TTS_VOLUME_HINDI=+0%

# Low-power video rendering (static slides + FFmpeg)
VIDEO_WIDTH=1920
VIDEO_HEIGHT=1080
VIDEO_FPS=10
VIDEO_CRF=23
VIDEO_PRESET=ultrafast
# Use 1280x720 and 8 fps for the lightest fallback
PUBLIC_BASE_URL=http://localhost:8000
